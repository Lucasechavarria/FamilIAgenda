{
    "env": {
        "UV_LINK_MODE": "copy"
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://familiagenda-api.onrender.com/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}